---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const d = project.data;
---
<article class="card">
  <div class="top">
    <h3><a href={`/projects/${project.id}/`}>{d.title}</a></h3>
    <span class="year">{d.year}</span>
  </div>
  <p class="tagline">{d.tagline}</p>
  <ul class="tech">{d.tech.map((t) => <li>{t}</li>)}</ul>
  <div class="links">
    <a href={`/projects/${project.id}/`}>Read more →</a>
    {d.demo && <a href={d.demo} rel="noopener">Live site ↗</a>}
    {d.download && <a href={d.download} rel="noopener">Download ↗</a>}
    {d.repo && <a href={d.repo} rel="noopener">Code ↗</a>}
  </div>
</article>

<style>
  .card { position: relative; display: flex; flex-direction: column; gap: 0.6rem; padding: 1.15rem 1.2rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); transition: border-color 0.15s; }
  .card:hover { border-color: var(--accent); }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  h3 { margin: 0; font-size: 1.1rem; }
  h3 a { color: var(--text); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .year { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); }
  .tagline { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.55; flex: 1; }
  .tech { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tech li { font-family: var(--mono); font-size: 0.72rem; padding: 0.1em 0.5em; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }
  .links { display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.88rem; }
  .links a { position: relative; z-index: 1; text-decoration: none; }
  .links a:hover { text-decoration: underline; }
</style>
