---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Blog" description="Articles by Surajit Basak on web development and technology.">
  <p class="eyebrow">Blog</p>
  <h1>Writing</h1>
  {posts.length ? (
    <ul class="list">
      {posts.map((p) => (
        <li><a href={`/blog/${p.id}/`}><span class="t">{p.data.title}<span class="d">{p.data.description}</span></span><span class="m">{fmt(p.data.date)}</span></a></li>
      ))}
    </ul>
  ) : (
    <p class="empty">No posts yet. They're on the way.</p>
  )}
</Base>
