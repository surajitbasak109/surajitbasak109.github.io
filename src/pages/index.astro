---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const notes = await getCollection('notes');
const groups = [...new Set(notes.map((n) => n.data.group))];
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base>
  <section class="hero">
    <img src={SITE.avatar} alt={`Photo of ${SITE.title}`} width="112" height="112" />
    <div>
      <p class="eyebrow">{SITE.role}</p>
      <h1>Hi, I'm Surajit 👋</h1>
      <p class="lead">
        I'm a web software engineer from West Bengal, India, working at {SITE.employer}.
        I build robust web applications and like keeping up with what's new in tech:
        web trends, crypto, stock-market analysis and gaming.
      </p>
      <div class="actions">
        <a class="btn primary" href={SITE.resume}>Download resume</a>
        <a class="btn" href={`mailto:${SITE.email}`}>Email me</a>
        <a class="btn" href={SITE.links[0].href}>GitHub</a>
      </div>
    </div>
  </section>

  <h2>Latest writing</h2>
  {posts.length ? (
    <ul class="list">
      {posts.map((p) => (
        <li><a href={`/blog/${p.id}/`}><span class="t">{p.data.title}</span><span class="m">{fmt(p.data.date)}</span></a></li>
      ))}
    </ul>
  ) : (
    <p class="empty">No posts yet. They're on the way.</p>
  )}

  <h2>Notes</h2>
  <p class="muted">Interview-prep and study notes, {notes.length} so far.</p>
  <ul class="list">
    {groups.map((g) => {
      const first = notes.filter((n) => n.data.group === g).length;
      return <li><a href={`/notes/#${g.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}><span class="t">{g}</span><span class="m">{first} {first === 1 ? 'note' : 'notes'}</span></a></li>;
    })}
  </ul>
</Base>

<style>
  .hero { display: flex; gap: 1.75rem; align-items: flex-start; margin-bottom: 1rem; }
  .hero img { border-radius: 50%; flex: none; object-fit: cover; border: 3px solid var(--surface); box-shadow: 0 0 0 1px var(--border); }
  .hero h1 { margin: 0.2rem 0 0.75rem; }
  .lead { font-size: 1.12rem; margin: 0 0 1.25rem; }
  .actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  @media (max-width: 560px) { .hero { flex-direction: column; gap: 1rem; } .hero img { width: 88px; height: 88px; } }
</style>
